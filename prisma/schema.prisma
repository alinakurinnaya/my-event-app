generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Перечисление для статуса посещения
enum AttendanceStatus {
  pending
  attended
  not_attended
}

// Модель Ивента
model Event {
  id               String        @id @default(uuid())
  title            String
  description      String
  startsAt         DateTime      @map("starts_at")
  location         String
  registrationOpen Boolean       @default(true) @map("registration_open")
  capacity         Int?
  createdAt        DateTime      @default(now()) @map("created_at")
  
  participants     Participant[]
}

// Модель Участника
model Participant {
  id               String           @id @default(uuid())
  eventId          String           @map("event_id")
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  name             String
  email            String
  phone            String?
  comment          String?
  attendanceStatus AttendanceStatus @default(pending) @map("attendance_status")
  
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Защита от дублей: email уникален в рамках одного ивента
  @@unique([eventId, email])
}

// Модель Админа
model Admin {
  id           String @id @default(uuid())
  login        String @unique
  passwordHash String @map("password_hash")
}